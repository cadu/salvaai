{
  "name": "salvaai",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "build": "bun run --filter='*' build",
    "test": "bun test",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:migrate": "bun run --filter='@salvaai/api' db:migrate",
    "db:studio": "bun run --filter='@salvaai/api' db:studio"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
  ]
}
