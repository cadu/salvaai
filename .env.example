# Conexão com o Postgres do Docker Compose (compose.yaml na raiz)
DATABASE_URL=postgres://salvaai:salvaai@localhost:5432/salvaai

# better-auth
BETTER_AUTH_URL=http://localhost:3001
# gere um segredo forte com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio

# CORS — origem permitida pelo better-auth (trusteOrigins)
CORS_ORIGIN=http://localhost:5173
